---
import Disclosure from "./Disclosure";

interface Props {
  summary: string;
  open?: boolean;
}

const { summary, open = false } = Astro.props;
---

{/* Not client:visible: Base UI only sets hidden="until-found" after hydration, so find-in-page can't reach panels that haven't hydrated yet. */}
<Disclosure client:idle summary={summary} open={open}>
  <slot />
</Disclosure>
