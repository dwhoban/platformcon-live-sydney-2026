---
import { ArrowLeftIcon, ArrowRightIcon } from "@phosphor-icons/react";
import type { GuidePage } from "../lib/guide";

interface Props {
  prev?: GuidePage;
  next?: GuidePage;
}

const { prev, next } = Astro.props;
const label = (page: GuidePage) => (page.lesson ? `${page.lesson} ${page.label}` : page.label);
const card = "flex flex-col gap-1 rounded-lg p-4 ring ring-kumo-line hover:bg-kumo-tint";
---

{
  (prev || next) && (
    <nav
      aria-label="Previous and next pages"
      class="mt-16 grid gap-3 border-t border-kumo-line pt-8 sm:grid-cols-2"
      data-pagefind-ignore
    >
      {prev && (
        <a href={prev.href} class={card}>
          <span class="flex items-center gap-1.5 text-sm text-kumo-subtle">
            <ArrowLeftIcon size={14} />
            Previous
          </span>
          <span class="text-base font-medium text-kumo-link">{label(prev)}</span>
        </a>
      )}
      {next && (
        <a href={next.href} class:list={[card, "items-end text-right sm:col-start-2"]}>
          <span class="flex items-center gap-1.5 text-sm text-kumo-subtle">
            Next
            <ArrowRightIcon size={14} />
          </span>
          <span class="text-base font-medium text-kumo-link">{label(next)}</span>
        </a>
      )}
    </nav>
  )
}
