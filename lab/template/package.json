{
  "name": "agent-template",
  "description": "Agent golden path template: an AI agent on Cloudflare with its own identity, scoped tools, approval gates, usage limits and tracing by default",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types env.d.ts --include-runtime false --strict-vars false",
    "test": "vitest run --config src/tests/vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.7.0",
    "@cloudflare/kumo": "^2.6.0",
    "@earendil-works/chord": "~1.4.0",
    "@earendil-works/pi-ai": "~1.4.0",
    "@earendil-works/pi-durable": "~1.4.0",
    "@earendil-works/pi-telemetry": "~1.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.5.0",
    "@streamdown/code": "^2.0.0",
    "agents": "^0.30.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "typebox": "1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.6",
    "vitest": "5.0.5",
    "wrangler": "^4.153.0"
  }
}
